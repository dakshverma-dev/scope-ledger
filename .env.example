# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Optional. Not used by the app (no sign-in); only the live test uses it to prove it can reach nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role / secret key. SERVER ONLY. All database calls go through owner-checked routines.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Anthropic API key (SERVER ONLY). When empty, analysis uses the built-in extractor.
ANTHROPIC_API_KEY=
# Model used when ANTHROPIC_API_KEY is set.
MODEL_ID=claude-haiku-5-5
# Public origin of the deployment, e.g. https://scope-ledger.vercel.app (no trailing slash)
APP_BASE_URL=http://localhost:3000
