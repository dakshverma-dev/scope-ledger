# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. Used only by server code to act as the signed-in visitor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role / secret key. SERVER ONLY. Used exclusively by token-verified review routines.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key. SERVER ONLY.
ANTHROPIC_API_KEY=
# Model identifier from the product specification. Do not change silently.
MODEL_ID=claude-haiku-5-5
# Public origin of the deployment, e.g. https://scope-ledger.vercel.app (no trailing slash)
APP_BASE_URL=http://localhost:3000
